{
    "version": 2,
    "builds": [
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/admin/assets/(.*)",
            "dest": "/public/admin/assets/$1"
        },
        {
            "src": "/admin/logo\\.(png|svg)",
            "dest": "/public/admin/logo.$1"
        },
        {
            "src": "/admin/(.*)",
            "dest": "/public/admin/index.html"
        },
        {
            "src": "/static/(.*)",
            "dest": "/public/static/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html"
        }
    ]
}